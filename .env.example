# Copy to .env for local development. For a deployment, set the same names as
# build environment variables on your host. See README.md → Configuration.

# --- development ---
# commercetools project that `npm start` opens.
INITIAL_PROJECT_KEY=

# --- production build ---
# Where this app is served. DNS + SSL must resolve before the production build:
# appkit bakes this into <base href> and the CSP self URL.
APPLICATION_URL=
# Assigned by the Merchant Center on registration (see REGISTRATION.md).
CUSTOM_APPLICATION_ID=
# MC "Application URL path". Globally unique across ALL commercetools orgs and
# immutable after registration — namespace it, e.g. acme-customer-service.
# Must match the registration exactly, or the Merchant Center reload-loops.
ENTRY_POINT_URI_PATH=

# --- "shop as customer" / buy on behalf of ---
# DEFAULTS ONLY. These can be overridden at runtime from the in-app Settings
# screen (stored as a Custom Object), so a deployment can be re-pointed at a
# different storefront without a rebuild.
#
# Origin only, no path — the launch path is appended automatically.
STOREFRONT_B2C_URL=
# Defaults to STOREFRONT_B2C_URL when unset.
STOREFRONT_B2B_URL=

# Extra origins to allow in an iframe, comma-separated. The CSP frame-src
# allowlist is COMPILED INTO THE BUNDLE, so any storefront you might later select
# from the Settings screen must be listed at build time to be embeddable —
# otherwise the launch falls back to opening a new browser tab (which always
# works). The Settings screen shows the compiled list and flags what is missing.
CSR_EXTRA_FRAME_SRC=

# NOTE: there is no shared secret for the CSR handshake. The launch is brokered
# through a single-use, short-lived Custom Object token that the storefront
# redeems with its own commercetools credentials. Your storefront must implement
# the redemption endpoint — see docs/CSR-STOREFRONT-INTEGRATION.md.
